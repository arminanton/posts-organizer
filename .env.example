# Required for the run command
GEMINI_API_KEY=your_gemini_api_key_here
TARGET_ACCOUNT=target_instagram_account

# Optional runtime configuration
GEMINI_MODEL=gemini-1.5-flash
# Instagram username used by `instagram-organizer login` and for session reuse during `run`
IG_USERNAME=
BASE_DIR=.
RESULTS_DIR=results
IG_SESSION_FILE=state/.ig_session
MAX_AI_IMAGES=10

# Gemini transport strategy
# Safe inline threshold for prompt text + image bytes. When the estimated inline
# request is larger than this value, the application attempts the Files API.
GEMINI_INLINE_MAX_BYTES=18000000
# Enable Files API fallback for oversized payloads.
GEMINI_USE_FILES_API=true
# If the Files API path fails, split the post into ordered batches and run a
# final synthesis prompt over the batch analyses.
GEMINI_USE_BATCH_FALLBACK=true

# Logging
LOG_LEVEL=INFO
APP_LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log
